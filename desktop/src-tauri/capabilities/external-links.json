{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "external-links",
  "description": "Allow the loopback-hosted Desktop UI to open web links in the system browser.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
