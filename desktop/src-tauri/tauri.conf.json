{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESPConfig Designer",
  "version": "1.4.0",
  "identifier": "com.espconfigdesigner.desktop",
  "build": {
    "frontendDist": "../../esp-config-designer/frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/ecd-app/": "ecd-app/"
    }
  }
}
