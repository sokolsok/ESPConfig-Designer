TZ=Europe/Warsaw
ECD_PORT=8099
ECD_USE_ESPHOME_SHARED_PATH=false

# Recommended for standalone deployments exposed on a LAN.
# Set ECD_AUTH_MODE=none only if another trusted layer handles access.
ECD_AUTH_MODE=basic
ECD_AUTH_USERNAME=admin
ECD_AUTH_PASSWORD=change-me

# Used only with compose.serial.yaml. Prefer a stable /dev/serial/by-id path.
ECD_SERIAL_DEVICE=/dev/ttyUSB0
ECD_SERIAL_CONTAINER_DEVICE=/dev/ttyUSB0
