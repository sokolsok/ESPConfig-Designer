# Python
**/__pycache__/
*.py[cod]
.venv/
venv/
.coverage
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node.js and frontend output
**/node_modules/
/esp-config-designer-frontend/dist/
/esp-config-designer-frontend/runtime/

# Legacy local frontend tests are audited in Stage 2.
/esp-config-designer-frontend/tests/*
!/esp-config-designer-frontend/tests/runtimeCapabilities.test.mjs
!/esp-config-designer-frontend/tests/runtimeDiagnostics.test.mjs

# Desktop build and packaged resources
/desktop/src-tauri/target/
/desktop/resources/*
!/desktop/resources/ecd-app/
/desktop/resources/ecd-app/*
!/desktop/resources/ecd-app/README.txt

# Local Docker state
/docker/.env
/docker/config/
/docker/data/
/docker/build/

# Local environment files
.env
.env.*
!.env.example
!**/.env.example
!/esp-config-designer-frontend/.env.local

# Private working notes
/R&D/

# Reports and temporary files
*.log
*.tmp
*.bak

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
