{
  "name": "esp-config-designer-frontend",
  "private": true,
  "version": "1.3.3",
  "type": "module",
  "scripts": {
    "check:catalog": "node ../shared/schema-catalog-contract.mjs",
    "generate:actions": "node scripts/generate-action-definitions.js",
    "check:actions": "node scripts/generate-action-definitions.js --check",
    "test": "npm run check:catalog && npm run check:actions && node --test --test-concurrency=1 --import=./tests/register-extensionless-js-loader.mjs && node --test ../shared/tests/schemaCatalogContract.test.mjs",
    "test:capabilities": "node --test tests/runtimeCapabilities.test.mjs",
    "test:diagnostics": "node --test tests/runtimeDiagnostics.test.mjs",
    "dev": "node scripts/start-dev.js",
    "serve": "vite",
    "build": "npm run check:catalog && vite build && node ../shared/schema-catalog-contract.mjs --projection dist",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mdi/svg": "^7.4.47",
    "esptool-js": "^0.6.0",
    "highlight.js": "^11.11.1",
    "js-yaml": "^5.2.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.1.3"
  }
}
